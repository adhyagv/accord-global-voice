# Optional OpenAI-compatible chat provider. Leave blank to use Accord's guided fallback.
ACCORD_LLM_API_KEY=
ACCORD_LLM_BASE_URL=https://api.openai.com/v1
ACCORD_LLM_MODEL=gpt-4o-mini

# Optional: store the local SQLite snapshot somewhere outside the repository.
# ACCORD_DB_PATH=C:\Users\YourName\accord-data\accord.sqlite3
# ACCORD_PERSISTENCE=sqlite

# Alexa Skills Kit adapter: disabled by default. When enabled locally, require this
# temporary shared secret header. This does NOT verify Amazon signatures/timestamps.
ACCORD_ALEXA_ENABLED=false
ACCORD_ALEXA_SHARED_SECRET=

# Local prototype controls.
ACCORD_ASSISTANT_RATE_LIMIT_PER_MIN=60
ACCORD_WORKLOAD_DRIFT_THRESHOLD=0.40
